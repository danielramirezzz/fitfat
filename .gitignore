# Dependencias (se reinstalan con npm)
node_modules/

# Versión web construida (Render la genera con "npm run build")
app/dist/
app/.expo/
app/expo-env.d.ts

# Base de datos local y claves: NUNCA al repositorio
server/datos/
.env
.env.*
!.env.example

# Sistema
.DS_Store
Thumbs.db
*.log

# Copia del git original de la plantilla de Expo (no se sube)
.git-plantilla-expo/

# Proyecto nativo generado por 'expo prebuild' (se regenera; el APK se hace con scripts/apk)
app/android/
app/ios/

# APK generado (muy pesado para git)
*.apk

# Video del pitch ya renderizado (se regenera con 'npm run render' en video/)
pitch/*.mp4

# Notas y configuración locales del editor (no se suben)
CLAUDE.md
.claude/
app/.claude/
