{
  "name": "fitfat-server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend de FitFat: usuarios, contraseñas y sesiones (Express + SQLite)",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "test": "node --test"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "libsql": "^0.5.29",
    "nodemailer": "^10.5.0"
  }
}
