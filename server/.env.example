# Copia este archivo como ".env" (en esta misma carpeta server/) y llena los valores.
# El archivo .env tiene claves: NO lo subas a GitHub ni lo compartas.

# --- Correo real (códigos para recuperar la contraseña) ---
# Cuenta de Gmail que envía los correos y su "contraseña de aplicación" (16 letras,
# se crea en https://myaccount.google.com/apppasswords). NO es tu contraseña normal.
SMTP_USER=
SMTP_PASS=

# --- Continuar con Google (real) ---
# ID de cliente OAuth tipo "Aplicación web" de Google Cloud. Termina en .apps.googleusercontent.com
GOOGLE_CLIENT_ID=
